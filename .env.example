# Tioras POS — Environment Configuration Template
PORT=3000

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your real credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# POS API Key — protects all /api/* routes
# Set this to any random string. Must also be set as VITE_API_KEY in frontend/.env
POS_API_KEY=change-me-to-a-random-secret

# Optional ERPNext Sync
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
